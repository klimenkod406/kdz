# Конфигурация Server 2 (Хранение и админ-панель)

# Порт сервера
PORT=3002

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=postgres
DB_PASSWORD=your_password

# Сессии
SESSION_SECRET=your_secret_key_change_in_production

# Синхронизация с Server 1
SYNC_SECRET=kdz-sync-secret-2026-change-in-production-if-public

# Для HTTPS: cookie с флагом Secure (иначе оставьте false / не задавайте)
# SESSION_COOKIE_SECURE=true

# Сетевые настройки
HOST=0.0.0.0

# Администратор по умолчанию
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
