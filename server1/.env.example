# Конфигурация Server 1 (Прием заявок)

# Порт сервера
PORT=3001

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=postgres
DB_PASSWORD=your_password

# Синхронизация с Server 2 (одинаковый секрет на обоих серверах, мин. 16 символов)
SERVER2_URL=http://localhost:3002
SYNC_INTERVAL_MINUTES=5
SYNC_SECRET=сгенерируйте_случайную_строку_64_hex_символа

# Сетевые настройки
HOST=0.0.0.0
